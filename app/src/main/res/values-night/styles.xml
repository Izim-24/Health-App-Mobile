        <item name="android:colorPrimary">@color/primary_green</item>
        <item name="android:colorBackground">#0F1118</item>
        <item name="android:windowBackground">#0F1118</item>
        <item name="android:statusBarColor">#0F1118</item>
        <item name="android:navigationBarColor">#1A1D27</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
